---
source: crates/pixi_build_ros/src/build_script.rs
expression: script
---
:: Generated by pixi-build-ros: a ROS
:: package with build type cmake.
setlocal
set "PYTHONPATH=%LIBRARY_PREFIX%\lib\site-packages;%SP_DIR%"

:: MSVC is preferred.
set CC=cl.exe
set CXX=cl.exe

:: ROS_BUILD_SHARED_LIBS (catkin's define for shared builds; code ported from ROS 1
:: still checks it for dllexport) and NOGDI, also for build systems that don't get
:: CMake's flags (such as qmake): via the CL environment variable, see
:: https://learn.microsoft.com/en-us/cpp/build/reference/cl-environment-variables?view=msvc-170
set CL=/DROS_BUILD_SHARED_LIBS=1 /DNOGDI=1

if not exist build mkdir build
pushd build

:: Name intermediate directories and object files by short hashes (CMake >= 4.2): long
:: package names otherwise push object paths past MSVC's 260 characters (error C1083).
cmake ^
    -G "Ninja" ^
    -DCMAKE_INTERMEDIATE_DIR_STRATEGY=SHORT ^
    --compile-no-warning-as-error ^
    -DCMAKE_INSTALL_PREFIX=%LIBRARY_PREFIX% ^
    -DCMAKE_BUILD_TYPE=Release ^
    -DCMAKE_INSTALL_SYSTEM_RUNTIME_LIBS_SKIP=ON ^
    -DBUILD_SHARED_LIBS=ON ^
    -DPYTHON_EXECUTABLE=%PYTHON% ^
    -DPython_EXECUTABLE=%PYTHON% ^
    -DPython3_EXECUTABLE=%PYTHON% ^
    -DSETUPTOOLS_DEB_LAYOUT=OFF ^
    -DBoost_USE_STATIC_LIBS=OFF ^
     ^
    /my/source
if %errorlevel% neq 0 exit 1

set "BUILD_PARALLEL_ARGS="
if "%PKG_NAME%" == "ros2-eigenpy" set "BUILD_PARALLEL_ARGS=--parallel 1"
cmake --build . --config Release --target all %BUILD_PARALLEL_ARGS%
if %errorlevel% neq 0 exit 1

cmake --build . --config Release --target install
if %errorlevel% neq 0 exit 1

:: The prefix is reused and `cmake --install` never removes files, so package
:: what this build installed rather than everything new in the prefix.
type install_manifest.txt >>"%RATTLER_BUILD_PACKAGE_FILES%"
if %errorlevel% neq 0 exit 1

if "%PKG_NAME%" == "ros2-ros-workspace" (
    :: Copy the [de]activate scripts to %PREFIX%\etc\conda\[de]activate.d.
    :: This will allow them to be run on environment activation.
    :: The .sh scripts are what conda runs in Git Bash / MSYS2 / Cygwin.
    for %%F in (activate deactivate) DO (
        if not exist %PREFIX%\etc\conda\%%F.d mkdir %PREFIX%\etc\conda\%%F.d
        copy %RECIPE_DIR%\%%F.bat %PREFIX%\etc\conda\%%F.d\%PKG_NAME%_%%F.bat
        copy %RECIPE_DIR%\%%F.ps1 %PREFIX%\etc\conda\%%F.d\%PKG_NAME%_%%F.ps1
        copy %RECIPE_DIR%\%%F.sh %PREFIX%\etc\conda\%%F.d\%PKG_NAME%_%%F.sh
    )
)
