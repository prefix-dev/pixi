{% set PYTHON="%PYTHON%" if build_platform == "windows" else "$PYTHON" -%}
{%- set OPTIONS = ([verbosity_flag] if verbosity_flag else []) + [
    "--no-deps",
    "--no-build-isolation",
    "--no-index"
] + extra_args + (["--editable"] if editable else [])
-%}

{% if build_platform == "windows" -%}
{% set OPTIONS = OPTIONS | join(" ^\n        ") -%}
{% else -%}
{% set OPTIONS = OPTIONS | join(" \\\n        ") -%}
{% endif -%}

{% if installer == "uv" -%}
uv pip install --python "{{ PYTHON }}" --reinstall {{ OPTIONS }} "{{ manifest_root }}"
{% elif build_platform == "windows" -%}
"{{ PYTHON }}" -m pip install --force-reinstall {{ OPTIONS }} "{{ manifest_root }}"
{% else %}
"{{ PYTHON }}" -m pip install --force-reinstall {{ OPTIONS }} "{{ manifest_root }}"
{% endif -%}

{% if build_platform == "windows" -%}
if errorlevel 1 exit 1
{% endif %}
